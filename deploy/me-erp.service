[Unit]
Description=Madhusudhan Earthmover ERP (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=meerp
Group=meerp
WorkingDirectory=/srv/me-erp/app
ExecStart=/srv/me-erp/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 3 --timeout 120 --access-logfile -
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
