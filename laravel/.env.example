# Copy to .env and fill in. Never share the real .env.
APP_NAME="Madhusudhan Earthmover ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.example.com
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=single
LOG_LEVEL=warning

# MySQL / MariaDB database (Hostinger: hPanel -> Databases -> MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=600
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
